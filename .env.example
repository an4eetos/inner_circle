# Local development settings. `make setup` copies this to .env (git-ignored).
# Every value here is a local-only default; staging/prod get theirs from the secrets manager.

APP_ENV=local
HTTP_ADDR=:18080

# Host ports for infra/docker-compose.yml (chosen to avoid clashing with other local stacks)
POSTGRES_PORT=55432
S3_PORT=58333
MAILPIT_UI_PORT=58025
MAILPIT_SMTP_PORT=51025

DATABASE_URL=postgres://inner_circle:inner_circle@localhost:55432/inner_circle?sslmode=disable
DB_AUTO_MIGRATE=true
LOG_LEVEL=debug
LOG_FORMAT=text
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Uncomment to export traces to a local OTLP collector (e.g. Jaeger all-in-one)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
